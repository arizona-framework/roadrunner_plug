{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":pinDevDependencies",
    ":pinDigestsDisabled"
  ],
  "packageRules": [
    {
      "matchFileNames": [".github/**/*.yml"],
      "groupName": "dev tools"
    },
    {
      "matchManagers": ["mix"],
      "groupName": "mix deps"
    }
  ]
}
